OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional Legion code embeddings. Explicit opt-in sends bounded source-derived
# symbol text and Issue queries to Google. make solve remains memory-free.
# EMBEDDINGS=on|off on memory Make targets overrides this setting.
SAGE_LEGION_EMBEDDINGS_ENABLED=false
# Compact solve packet; legion-retrieve keeps its explicit --max-chars budget.
SAGE_LEGION_INITIAL_CONTEXT_CHARS=4000
SAGE_LEGION_EMBEDDING_MODEL=gemini-embedding-2
SAGE_LEGION_EMBEDDING_DIMENSIONS=3072
SAGE_LEGION_EMBEDDING_MAX_NODES=2000
SAGE_LEGION_EMBEDDING_DEADLINE_SECONDS=300
SAGE_LEGION_EMBEDDING_TIMEOUT_SECONDS=30
# Independent single-document requests; raise deliberately within API quotas (1-8).
SAGE_LEGION_EMBEDDING_CONCURRENCY=1
SAGE_LEGION_EMBEDDING_RETRIES=1
# Provisional cosine acceptance floor; calibrate against your Issue corpus.
SAGE_LEGION_EMBEDDING_MIN_SIMILARITY=0.45
# Default: persistent local qdrant/ beside the selected SQLite file (one owner).
# Set PATH or URL, never both. Remote credentials require HTTPS.
SAGE_LEGION_QDRANT_PATH=
SAGE_LEGION_QDRANT_URL=
SAGE_LEGION_QDRANT_API_KEY=
# OpenAI's SDK retries temporary 429 and connection failures with backoff.
# Quota, credit, and spend-limit failures remain non-recoverable until the
# corresponding OpenAI project or organization setting is corrected.
OPENAI_MAX_RETRIES=2

# Context sharing with the configured Google model defaults to approved; set
# this to false when the repository must not use Google.
SAGE_GOOGLE_MODEL_CONTEXT_APPROVED=true
# Sage has exactly two model roles, configurable without editing Python source.
SOLVER_MODEL=gpt-5.4-mini
REVIEWER_MODEL=gemini-3.5-flash
# Optional trusted JSON list; commands run only inside the networkless sandbox.
SAGE_VERIFICATION_COMMANDS_JSON=[]
# Opt-in shared solve/legion-solve tooling check before model/embedding calls.
# Requires a configured required pytest command and a prepared offline image.
SAGE_VERIFICATION_PREFLIGHT=false
SAGE_VERIFICATION_PREFLIGHT_DEPENDENCIES_JSON=[]

# Optional LangSmith observability. Enabling tracing sends agent prompts,
# repository context, and structured outputs to the configured LangSmith
# workspace. Keep tracing disabled unless that data transfer is approved.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sage-v2
# Required only when the API key can access multiple LangSmith workspaces.
LANGSMITH_WORKSPACE_ID=
# Set either value to true to keep that payload out of LangSmith traces.
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

SAGE_MAX_TURNS=30
SAGE_RUNS_DIR=.sage/runs
SAGE_SANDBOX_IMAGE=sage-sandbox:v2
SAGE_COMMAND_TIMEOUT_SECONDS=60
SAGE_MAX_TOOL_OUTPUT_CHARS=12000

# Experimental local/trusted-GitHub navigation; enabling sends bounded Issue/plan/source to TypeSafe.
SAGE_JEV_NAVIGATION_MODE=off
SAGE_JEV_NAVIGATION_POLICY=excerpts
TYPESAFE_API_KEY=
SAGE_JEV_MODEL=jev-1.13.0
# actions policy: one or two dependent read-only operations per root tool call.
SAGE_JEV_MAX_FOLLOWUP_ACTIONS=1
# Inclusive actions-policy gates; both the selected action and overall decision must pass.
SAGE_JEV_READ_PROBABILITY_THRESHOLD=0.65
SAGE_JEV_SEARCH_PROBABILITY_THRESHOLD=0.75
SAGE_JEV_GRAPH_PROBABILITY_THRESHOLD=0.80
SAGE_JEV_ACTION_CONFIDENCE_THRESHOLD=0.50
SAGE_JEV_TIMEOUT_SECONDS=2
SAGE_JEV_RUN_WAIT_SECONDS=8
# Mode=on logs full bounded Issue/plan/source input at INFO; false keeps only summaries.
# Treat console logs as sensitive. This does not enable replay capture.
SAGE_JEV_LOG_INPUT=true
# Sensitive exact request/response capture for LOCAL replay only; never upload it.
SAGE_JEV_CAPTURE=false

# Optional GitHub controller limits. GitHub Actions supplies its job-scoped
# token at runtime; do not add a GitHub token to this file. The installed
# workflow keeps credentials and the remote Qdrant URL in GitHub Secrets; all
# other values are configured in its top-level YAML env block. GitHub memory
# defaults embeddings on there, while this local default remains opt-in.
SAGE_GITHUB_API_TIMEOUT_SECONDS=30
SAGE_GITHUB_MAX_COMMENTS=20
SAGE_GITHUB_MAX_COMMENT_PAGES=5
SAGE_GITHUB_MAX_CONTEXT_CHARS=40000
