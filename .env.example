OPENAI_API_KEY=
GEMINI_API_KEY=
# OpenAI's SDK retries temporary 429 and connection failures with backoff.
# Quota, credit, and spend-limit failures remain non-recoverable until the
# corresponding OpenAI project or organization setting is corrected.
OPENAI_MAX_RETRIES=2

# V2 is the only runtime. Context sharing with the configured Google model
# defaults to approved; set this to false when the repository must not use Google.
SAGE_RUNTIME=v2
SAGE_MODEL_PROFILE=constrained-cross-provider
SAGE_GOOGLE_MODEL_CONTEXT_APPROVED=true
# V2 has exactly two model roles, configurable without editing Python source.
SAGE_V2_SOLVER_MODEL=gpt-5.4-mini
SAGE_V2_REVIEWER_MODEL=gemini-3.5-flash
# Admission is opt-in, reuses the Solver model, and persists its read-only scan.
SAGE_V2_ADMISSION_ENABLED=false
SAGE_V2_ADMISSION_MAX_TURNS=12
SAGE_V2_ADMISSION_CONTEXT_CHARS=48000
SAGE_MAX_CLARIFICATION_ROUNDS=2

# Optional controller-side research. The repository Docker sandbox stays
# network-disabled. Select tavily only when its API key is configured.
SAGE_RESEARCH_ENABLED=true
SAGE_WEB_SEARCH_PROVIDER=
SAGE_WEB_SEARCH_API_KEY=
SAGE_RESEARCH_TIMEOUT_SECONDS=15
SAGE_RESEARCH_MAX_RESULT_CHARS=12000
# Optional comma-separated public domain restrictions and trusted docs domains.
SAGE_RESEARCH_ALLOWED_DOMAINS=
SAGE_OFFICIAL_DOCUMENTATION_DOMAINS=
# Optional trusted JSON list; commands run only inside the networkless sandbox.
SAGE_VERIFICATION_COMMANDS_JSON=[]

# Optional LangSmith observability. Enabling tracing sends agent prompts,
# repository context, and structured outputs to the configured LangSmith
# workspace. Keep tracing disabled unless that data transfer is approved.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sage-v2
# Required only when the API key can access multiple LangSmith workspaces.
LANGSMITH_WORKSPACE_ID=
# Set either value to true to keep that payload out of LangSmith traces.
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

SAGE_MAX_TURNS=30
SAGE_RUNS_DIR=.sage/runs
SAGE_SANDBOX_IMAGE=sage-sandbox:v0
SAGE_COMMAND_TIMEOUT_SECONDS=60
SAGE_MAX_TOOL_OUTPUT_CHARS=12000

# Optional GitHub controller limits. GitHub Actions supplies its job-scoped
# token at runtime; do not add a GitHub token to this file.
SAGE_GITHUB_API_TIMEOUT_SECONDS=30
SAGE_GITHUB_MAX_COMMENTS=20
SAGE_GITHUB_MAX_COMMENT_PAGES=5
SAGE_GITHUB_MAX_CONTEXT_CHARS=40000
